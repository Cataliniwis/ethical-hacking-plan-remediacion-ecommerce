# Ejemplo de hardening para Nginx (dentro del bloque server { listen 443 ssl; ... })

# VULN-01 · Solo TLS moderno con cifrados AEAD (sin CBC ni RC4)
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers on;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

# VULN-05 · HSTS (agregar includeSubDomains solo después de validar todos los subdominios)
add_header Strict-Transport-Security "max-age=31536000" always;

# VULN-06 · Evitar MIME-sniffing
add_header X-Content-Type-Options "nosniff" always;

# VULN-07 · CSP sin 'unsafe-inline' (ajustar los orígenes reales del sitio).
# Si hay scripts inline imprescindibles, la aplicación debe generar un nonce por respuesta
# e incluirlo tanto en esta cabecera como en cada etiqueta <script nonce="...">.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

# VULN-02/03/04 · Atributos de cookies cuando Nginx actúa como proxy inverso (Nginx >= 1.19.3)
proxy_cookie_flags ~ httponly secure samesite=lax;
